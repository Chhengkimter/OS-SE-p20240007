#!/bin/bash
SRC_DIR="sample_project"
BACKUP_DIR="backups"
LOG_FILE="$BACKUP_DIR/backup_log.txt"
KEEP=2
set -euo pipefail
if [ ! -d "$SRC_DIR" ]; then
    echo "Error: $SRC_DIR not found in $(pwd)" >&2
    exit 1
fi
mkdir -p "$BACKUP_DIR"
timestamp=$(date +%Y%m%d-%H%M%S)
archive_name="${SRC_DIR}-${timestamp}.tar.gz"
archive_path="$BACKUP_DIR/$archive_name"
tar -czf "$archive_path" "$SRC_DIR"
echo "$(date '+%Y-%m-%d %H:%M:%S') - Created $archive_name" >> "$LOG_FILE"
mapfile -t archives < <(ls -1t "$BACKUP_DIR"/${SRC_DIR}-*.tar.gz 2>/dev/null)
if [ "${#archives[@]}" -gt "$KEEP" ]; then
    for old in "${archives[@]:$KEEP}"; do
        rm -f "$old"
        echo "$(date '+%Y-%m-%d %H:%M:%S') - Pruned $(basename "$old")" >> "$LOG_FILE"
    done
fi
